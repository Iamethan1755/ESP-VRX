# SPDX-License-Identifier: GPL-3.0-only
# C5VRX Wi-Fi bridge on a Seeed XIAO ESP32-S3 (ESP32-S3R8: 8 MB octal PSRAM, 8 MB flash).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Frame buffers and JPEG output live in PSRAM; the capture ring stays in
# internal SRAM (DMA at 10-20 MB/s). Boots without PSRAM, but logs it.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Native USB on the XIAO's USB-C is the console.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Core 1 belongs to the decoder; Wi-Fi, lwIP, HTTP and JPEG run on core 0.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# The decoder loops need real optimisation (ESP-IDF defaults to -Og).
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# A whole JPEG fits the TCP send buffer: one frame goes out without waiting
# for ACK round trips (default 5760 bytes is smaller than a live frame).
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
