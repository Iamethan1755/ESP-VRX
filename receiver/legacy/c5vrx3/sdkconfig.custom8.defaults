# Illustrative custom-board wiring, NOT a tested XIAO or PCB preset.
# Extra LSBs require weighted resistors; GPIO2 is a reset strapping pin.
CONFIG_C5VRX_CUSTOM_BOARD=y
CONFIG_C5VRX_PHASE8_HR_LIVE_TEST=y
CONFIG_C5VRX_DAC_8BIT=y
CONFIG_C5VRX_DAC_D0_GPIO=2
CONFIG_C5VRX_DAC_D1_GPIO=6
CONFIG_C5VRX_DAC_D2_GPIO=23
CONFIG_C5VRX_DAC_D3_GPIO=24
CONFIG_C5VRX_DAC_D4_GPIO=11
CONFIG_C5VRX_DAC_D5_GPIO=12
CONFIG_C5VRX_DAC_D6_GPIO=8
CONFIG_C5VRX_DAC_D7_GPIO=9
