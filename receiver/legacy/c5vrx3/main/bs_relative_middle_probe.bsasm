# Two-bundle steady-state Phase5 WBFM core.
# Full Q4/I4 (8-bit Cartesian) input at 40 MS/s.
# 20 MS/s unique 6-bit CVBS output, duplicated as [D,D] at 40 MHz DAC clock.
#
# Two instructions total; the first two output pairs establish the pipeline
# state after prefetch. Their DAC values are startup-only and untrusted.
#   address_delta  - steady-state bundle 1
#   emit           - steady-state bundle 2 (loops back to address_delta)
#
# LUT layout (dual-purpose 16-bit words):
#   LUT[packed_q4i4].bits[12:8]          = 5-bit Phase5 state (uniform polar bins)
#   LUT[(prev_phase5<<5)|curr_phase5]    = 6-bit DAC code (centroid delta, P20/G2)
#
# O26..O30 holds the previous Phase5 state across ALL ring/DMA boundaries.
# cfg eof_on downstream + cfg trailing_bytes 0 ensures PARLIO TX loop_transmission
# never generates a downstream EOF, so the BitScrambler runs uninterrupted forever.
#
# Reference: Seamless Golden 16K (build-golden-notel) -- proven best live build.
# P20 pedestal, G2 gain, current-minus-previous polarity.

cfg prefetch true
cfg eof_on downstream
cfg trailing_bytes 10
cfg lut_width_bits 16

# Embedded 1044-entry LUT. Hardware oracle v9 proved embedded LUT data is
# byte-exact at 20 MS/s; a separately preloaded LUT is NOT retained by the
# active PARLIO TX run on ESP32-C5 / IDF 6.0.x.
lut 5124 6662 7943 9735 11271 12808 14600 15880 16152 15384 12312 9241 5145 5145 5146 5148 5122 5124 5125 5126 5126 4615 3591 2055 25 25 25 26 26 795 2332 3614 3585 5123 6404 8197 9733 11270 13062 14342 15898 16154 15386 12315 9243 5148 5149 5151 5121 5122 5123 5124 5125 5125 4613 3590 2074 27 27 27 28 29 798 2079 2305 3842 5123 6915 8452 9989 11781 13061 14619 16155 16155 15388 12317 9245 5150 5151 5120 5121 5122 5123 5123 5124 5124 4613 3611 2076 28 28 29 30 31 768 512 2049 3330 5123 6659 8196 9988 11268 12828 14364 15644 16157 15389 12318 9247 5120 5120 5121 5122 5122 5123 5123 5124 5124 4636 3612 2077 29 30 30 31 0 16 527 1806 3598 5133 6669 8460 9740 11284 12820 14099 15635 16146 15378 12305 9232 5136 5135 5134 5133 5133 5132 5132 5132 5140 4628 3604 2067 19 18 17 16 16 15 270 2061 3597 5132 6924 8203 9749 11284 12564 14099 15891 16146 15377 12304 9231 5134 5133 5133 5132 5132 5131 5131 5141 5141 4629 3604 2067 19 18 17 15 14 13 268 1803 3339 5131 6410 7958 9493 11029 12565 14100 15635 16146 15377 12303 9229 5132 5131 5131 5130 5130 5130 5142 5142 5142 4629 3605 2068 19 17 14 12 11 10 522 2057 3849 5129 6679 8215 9495 11030 12822 14357 16148 16146 15372 12298 9225 5129 5129 5128 5128 5128 5144 5144 5144 5143 4631 3607 2070 20 4 6 7 7 7 520 2312 3592 5144 6680 7960 9497 11289 12825 14618 15900 16130 15364 12293 9222 5126 5127 5127 5127 5145 5145 5145 5146 5146 4635 3612 2078 2049 3 4 5 5 6 774 2054 3610 5146 6426 7963 9755 11292 13085 14367 15873 16130 15363 12292 9221 5125 5125 5126 5146 5147 5147 5147 5148 5149 4638 3615 3585 2050 3 3 4 5 5 773 2331 3867 5147 6684 8477 10013 11806 13087 14592 16129 16130 15363 12291 9220 5124 5125 5147 5148 5148 5148 5149 5150 5151 4608 4608 3585 2050 3 3 4 4 4 796 2332 3612 5149 6941 8478 10271 11520 13056 14593 15874 16130 15363 12291 9220 5124 5148 5148 5149 5149 5150 5150 5151 5120 5136 4623 3598 2062 13 13 12 12 20 532 1811 3347 5138 6674 8465 9744 11280 12815 14094 15885 16141 15372 12300 9228 5140 5140 5140 5139 5139 5138 5137 5136 5136 5135 4622 3597 2061 12 12 11 21 20 276 1811 3603 5138 6929 8208 9743 11278 12557 14349 15884 16140 15371 12299 9237 5141 5141 5140 5139 5139 5138 5137 5135 5134 5133 4620 3595 2059 11 10 22 21 21 21 1812 3347 5138 6417 7951 9485 11020 12555 14091 15626 16138 15370 12310 9238 5142 5141 5141 5140 5139 5137 5134 5132 5131 5130 4618 3593 2057 9 23 23 23 22 534 2069 3860 5138 6668 8202 9481 11273 12809 14344 16136 16136 15384 12312 9240 5143 5143 5143 5142 5140 5124 5126 5127 5127 5127 4616 3592 2056 24 24 24 25 25 537 2330 3612 5122 6660 7941 9734 11270 12807 14599 15879 16153 15385 12313 9242 5146 5147 5148 5150 5121 5123 5124 5125 5125 5126 4614 3590 2074 26 26 27 27 28 797 2079 3585 5122 6403 8196 9733 11269 13061 14342 15898 16155 15387 12315 9244 5149 5150 5151 5121 5122 5123 5123 5124 5125 5125 4613 3611 2075 27 28 29 29 30 799 2304 3841 5122 6915 8451 9988 11780 13061 14619 16156 16156 15388 12317 9246 5151 5120 5120 5121 5122 5123 5123 5124 5124 5124 4636 3612 2076 29 29 30 31 0 512 2049 3330 5122 6659 8195 9988 11268 12828 14364 15645 16157 15390 12318 9247 5120 5136 5135 5134 5134 5133 5133 5132 5132 5140 4628 3603 2067 18 18 17 16 16 527 1806 3597 5133 6668 8460 9740 11284 12820 14100 15891 16147 15378 12305 9232 9232 5135 5134 5133 5133 5132 5132 5131 5141 5140 4628 3603 2067 18 17 16 15 14 269 2061 3596 5132 6923 8203 9749 11285 12565 14356 15891 16147 15378 12305 12303 9230 5133 5132 5131 5131 5131 5130 5142 5141 5141 4629 3604 2067 18 17 15 13 12 267 1803 3338 5130 6410 7958 9494 11030 12565 14101 15892 16147 15377 15374 12300 9227 5130 5130 5129 5129 5129 5143 5143 5143 5142 4630 3605 2068 18 12 10 9 9 521 2056 3848 5128 6680 8216 9496 11287 12823 14615 16150 16148 16132 15366 12295 9223 5127 5128 5128 5128 5144 5144 5144 5145 5145 4633 3610 2076 2 4 5 6 6 519 2311 3591 5145 6681 7961 9754 11290 13083 14620 15902 15873 16131 15364 12293 9221 5126 5126 5126 5146 5146 5146 5147 5147 5148 4637 3615 2049 2 3 4 5 5 773 2054 3610 5147 6427 8219 9756 11549 13086 14367 14593 16130 16131 15363 12292 9221 5125 5125 5147 5147 5147 5148 5149 5149 5150 4639 3584 2049 2 3 3 4 4 773 2331 3868 5148 6940 8477 10270 11807 13056 12800 14337 15618 16131 15363 12292 9220 5124 5148 5148 5148 5149 5149 5150 5151 5120 4608 3585 2050 2 3 3 4 4 540 2076 3357 5149 6686 8478 10015 11264 11280 12815 14094 15886 16141 15373 12300 9228 5140 5140 5139 5139 5138 5138 5137 5136 5136 4623 3598 2061 13 12 12 12 20 532 1812 3603 5139 6930 8465 9744 9488 11023 12558 14093 15629 16140 15372 12299 9237 5140 5140 5139 5139 5138 5137 5136 5135 5134 4621 3597 2060 12 11 11 21 21 21 1812 3347 5139 6674 7953 7951 9486 11021 12556 14091 15627 16139 15370 12310 9237 5141 5141 5140 5139 5138 5137 5135 5133 5132 4619 3595 2058 10 10 22 22 22 277 1813 3604 5139 6417 6670 8204 9483 11274 12810 14345 16137 16137 15383 12311 9239 5142 5142 5141 5140 5138 5132 5130 5129 5129 4617 3592 2056 8 24 24 24 23 535 2327 3862 5140

controller_0:
    # L0..4 = exact Phase5 of previous worker's selected raw byte.
    # Latch into O26..30; set A=0 for upcoming worker_0.
    set 26..30 L0..L4,
    ldctda 0

worker_0:
    # A=0: routes middle byte (0..7) into LUT address (out[23:16]).
    # Emits previous Phase5 from O26..30 to duplicated output [Phase5, Phase5].
    set 0..4 O26..O30,
    set 8..12 O26..O30,
    set 16 0+a,
    set 17 1+a,
    set 18 2+a,
    set 19 3+a,
    set 20 4+a,
    set 21 5+a,
    set 22 6+a,
    set 23 7+a,
    read 16,
    write 16,
    adda 0

controller_1:
    # L0..4 = exact Phase5 of previous worker's selected raw byte.
    # Latch into O26..30; set A=8 for upcoming worker_1.
    set 26..30 L0..L4,
    ldctda 8

worker_1:
    # A=8: routes endpoint byte (8..15) into LUT address (out[23:16]).
    # Emits previous Phase5 from O26..30 to duplicated output [Phase5, Phase5].
    set 0..4 O26..O30,
    set 8..12 O26..O30,
    set 16 0+a,
    set 17 1+a,
    set 18 2+a,
    set 19 3+a,
    set 20 4+a,
    set 21 5+a,
    set 22 6+a,
    set 23 7+a,
    read 16,
    write 16,
    adda -8

controller_2:
    # L0..4 = exact Phase5 of previous worker's selected raw byte.
    # Latch into O26..30; set A=0 for upcoming worker_2.
    set 26..30 L0..L4,
    ldctda 0

worker_2:
    # A=0: routes middle byte (0..7) into LUT address (out[23:16]).
    # Emits previous Phase5 from O26..30 to duplicated output [Phase5, Phase5].
    set 0..4 O26..O30,
    set 8..12 O26..O30,
    set 16 0+a,
    set 17 1+a,
    set 18 2+a,
    set 19 3+a,
    set 20 4+a,
    set 21 5+a,
    set 22 6+a,
    set 23 7+a,
    read 16,
    write 16,
    adda 0

controller_3:
    # L0..4 = exact Phase5 of previous worker's selected raw byte.
    # Latch into O26..30; set A=8 for upcoming worker_3.
    set 26..30 L0..L4,
    ldctda 8

worker_3:
    # A=8: routes endpoint byte (8..15) into LUT address (out[23:16]).
    # Emits previous Phase5 from O26..30 to duplicated output [Phase5, Phase5].
    set 0..4 O26..O30,
    set 8..12 O26..O30,
    set 16 0+a,
    set 17 1+a,
    set 18 2+a,
    set 19 3+a,
    set 20 4+a,
    set 21 5+a,
    set 22 6+a,
    set 23 7+a,
    read 16,
    write 16,
    adda -8

