# Two-bundle steady-state Phase5 WBFM core.
# Full Q4/I4 (8-bit Cartesian) input at 40 MS/s.
# 20 MS/s unique 6-bit CVBS output, duplicated as [D,D] at 40 MHz DAC clock.
#
# Two instructions total; the first two output pairs establish the pipeline
# state after prefetch. Their DAC values are startup-only and untrusted.
#   address_delta  - steady-state bundle 1
#   emit           - steady-state bundle 2 (loops back to address_delta)
#
# LUT layout (dual-purpose 16-bit words):
#   LUT[packed_q4i4].bits[12:8]          = 5-bit Phase5 state (uniform polar bins)
#   LUT[(prev_phase5<<5)|curr_phase5]    = 6-bit DAC code (centroid delta, P20/G2)
#
# O26..O30 holds the previous Phase5 state across ALL ring/DMA boundaries.
# cfg eof_on downstream + cfg trailing_bytes 0 ensures PARLIO TX loop_transmission
# never generates a downstream EOF, so the BitScrambler runs uninterrupted forever.
#
# Reference: Seamless Golden 16K (build-golden-notel) -- proven best live build.
# P20 pedestal, G2 gain, current-minus-previous polarity.

cfg prefetch true
cfg eof_on downstream
cfg trailing_bytes 0
cfg lut_width_bits 16

# Embedded 1044-entry LUT. Hardware oracle v9 proved embedded LUT data is
# byte-exact at 20 MS/s; a separately preloaded LUT is NOT retained by the
# active PARLIO TX run on ESP32-C5 / IDF 6.0.x.
lut 1044 1562 1823 1830 1836 2098 2105 2110 6207 6204 6192 6436 6420 6420 6676 7188 532 1044 1300 1556 1556 1810 1806 1800 6400 6400 6400 6656 6656 6915 7177 7694 270 788 1049 1312 1318 1580 1587 1592 6718 6719 6716 6960 6948 7188 7444 7956 276 532 788 1044 1300 1300 1298 1550 6664 6912 6912 6912 7168 7424 7683 7944 265 527 788 795 1057 1319 1326 1331 6969 6975 6975 7228 7472 7460 7700 7956 20 276 532 788 788 1044 1044 1298 6926 7176 7168 7168 7424 7680 7936 3 2 264 525 788 794 1056 1063 1068 7218 7224 7229 7487 7484 7728 7972 20 20 276 532 532 788 788 1044 1044 7186 7182 7432 7424 7680 7680 7936 0 4096 3842 3591 3598 3348 3354 3105 3110 5164 5170 4919 4925 4671 4668 4400 4132 4116 3860 3604 3348 3348 3092 3092 3092 5140 5138 5134 4872 4864 4608 4352 4096 4096 3840 3585 3336 3342 3092 3099 2848 5414 5164 5169 4919 4926 4671 4412 4144 3876 3604 3348 3348 3092 3092 2836 2836 5396 5396 5394 5134 4872 4864 4608 4352 3840 3584 3328 3073 2823 2829 2836 2585 5663 5413 5419 5425 5175 4925 4671 4412 3888 3364 3092 2836 2836 2580 2580 2580 5652 5652 5652 5394 5390 5128 4864 4352 3584 3072 2816 2560 2562 2312 2319 2324 5914 5920 5925 5675 5682 5432 5183 4671 3132 2608 2340 2324 2324 2068 2068 2068 6164 6164 6164 5908 5906 5902 5640 5120 1024 1536 1792 1792 1792 2050 2057 2062 6164 6170 6175 6437 6444 6450 6713 7230 575 1084 1328 1572 1556 1812 1812 1812 6420 6420 6420 6676 6676 6930 7182 7688 264 768 1024 1280 1280 1536 1539 1544 6670 6676 6681 6943 6950 7212 7475 7992 318 575 828 1072 1316 1300 1300 1556 6676 6932 6932 6932 7188 7444 7698 7950 270 520 768 768 1024 1280 1280 1283 6921 6927 6932 7194 7457 7463 7726 7987 57 319 575 828 816 1060 1044 1300 6932 7188 7188 7188 7444 7700 7956 18 18 270 520 768 768 1024 1024 1024 7171 7177 7182 7444 7451 7713 7976 45 51 313 574 575 828 816 1060 1044 7188 7188 7444 7444 7700 7700 7956 20 4116 3858 3598 3592 3328 3328 3072 3072 5120 5122 4871 4877 4628 4634 4385 4134 4140 3890 3639 3390 3391 3132 3120 3108 5140 5140 5140 4884 4884 4628 4372 4116 4116 3860 3602 3342 3336 3072 3072 2816 5376 5120 5121 4871 4878 4628 4379 4128 3878 3628 3377 3384 3134 3135 2876 2864 5412 5396 5396 5140 4884 4884 4628 4372 3860 3604 3348 3090 2830 2824 2816 2560 5632 5376 5376 5376 5127 4877 4628 4377 3871 3365 3115 2865 2871 2621 2623 2620 5680 5668 5652 5396 5396 5140 4884 4372 3604 3092 2836 2580 2578 2318 2312 2304 5888 5888 5888 5632 5634 5384 5135 4628 3098 2592 2341 2348 2354 2104 2111 2111 6204 6192 6180 5908 5908 5908 5652 5140 1044 1556 1812 1812 1812 2066 2062 2056 6144 6144 6144 6400 6400 6402 6665 7182 532 1050 1311 1574 1580 1842 1849 1854 6463 6460 6448 6692 6676 6932 7188 7700 276 788 1044 1300 1300 1556 1554 1550 6664 6656 6656 6912 6912 7168 7427 7944 270 532 793 1056 1318 1324 1331 1592 6718 6975 6972 6960 7204 7444 7700 7956 276 532 788 788 1044 1300 1300 1298 6926 6920 6912 7168 7424 7424 7680 7939 9 271 532 795 801 1063 1070 1331 6969 7231 7231 7228 7472 7716 7956 20 20 276 532 788 788 1044 1044 1044 7186 7182 7176 7424 7424 7680 7936 0 2 264 525 532 794 800 1063 1068 7218 7224 7485 7487 7740 7728 7972 20 4116 3860 3604 3604 3348 3348 3092 3092 5140 5138 4878 4872 4608 4608 4352 4096 4096 3842 3591 3342 3348 3098 3105 3110 5164 5170 5175 4926 4927 4668 4400 4132 4132 3860 3604 3348 3348 3092 3092 2836 5396 5140 5138 4878 4872 4608 4352 4096 3840 3584 3329 3336 3086 3092 2843 2848 5414 5420 5425 5176 4926 4927 4668 4400 3888 3620 3348 3092 2836 2836 2836 2580 5652 5396 5396 5394 5134 4872 4608 4352 3840 3328 3072 2817 2823 2573 2580 2585 5663 5669 5675 5425 5431 5182 4927 4412 3644 3120 2852 2580 2580 2324 2324 2324 5908 5908 5908 5652 5650 5390 5128 4608 3072 2560 2304 2304 2306 2056 2063 2068 6170 6176 6181 5932 5938 5945 5695 5183 1087 1596 1840 1828 1812 2068 2068 2068 6164 6164 6164 6420 6420 6418 6670 7176 512 1024 1280 1536 1536 1794 1801 1806 6420 6426 6431 6694 6700 6963 7225 7742 318 831 1084 1328 1316 1556 1556 1556 6676 6676 6676 6932 6932 7188 7442 7950 264 512 768 1024 1280 1280 1283 1544 6670 6932 6937 6944 7206 7469 7731 7992 313 575 831 828 1072 1316 1300 1300 6932 6932 6932 7188 7444 7444 7700 7954 14 264 512 768 768 1024 1024 1283 6921 7183 7188 7195 7457 7720 7982 51 50 312 573 831 828 1072 1060 1044 7188 7188 7188 7444 7444 7700 7956 20 18 270 520 512 768 768 1024 1024 7170 7176 7437 7444 7706 7713 7975 44 4140 3890 3639 3646 3391 3388 3120 3108 5140 5140 4884 4884 4628 4628 4372 4116 4116 3858 3598 3336 3328 3072 3072 3072 5120 5122 5127 4878 4884 4635 4385 4134 4133 3883 3633 3383 3389 3135 3132 2864 5412 5140 5140 4884 4884 4628 4372 4116 3860 3604 3346 3342 3080 3072 2816 2816 5376 5376 5376 5127 4877 4884 4634 4383 3871 3621 3371 3121 2871 2877 2879 2620 5680 5412 5396 5396 5140 4884 4628 4372 3860 3348 3092 2834 2830 2568 2560 2560 5632 5632 5632 5377 5383 5134 4884 4377 3610 3104 2853 2604 2610 2360 2367 2367 5948 5936 5924 5652 5652 5396 5140 4628 3092 2580 2324 2324 2322 2062 2056 2048 6144 6144 6144 5888 5890 5897 5647 5140

address_delta_0:
    # L is Phase5(raw endpoint); A0..4 holds the previous endpoint phase.
    # LUT address remains exactly Golden: previous5:current5.
    set 16..20 L8..L12,
    set 21..25 A0..A4,
    set 26..30 L8..L12,
    ldctial

emit_0:
    # Low LUT bits are Golden DAC. Address next raw endpoint while retaining
    # the *entire* first IQ byte of this pair in O24..31 / B8..15.
    set 0..5 L0..L5,
    set 6..7 L,
    set 8..13 L0..L5,
    set 14..15 L,
    set 16..23 8..15,
    set 24..31 0..7,
    read 16,
    write 16,
    ldctib

