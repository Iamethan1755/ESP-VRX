# History-conditioned (HC) two-bundle WBFM demodulator. Generated by
# tools/gen_fm_hc.py from Golden fm.bsasm; only the decoder bank differs:
#   LUT[(prev_quadrant<<8)|raw].bits[12:8] = MAP 5-bit phase state
#   LUT[(prev<<5)|cur].bits[5:0]           = nominal P20/G2 DAC code
# Offline bench (tools/hc_estimator_bench.py): ~40 % fewer FM clicks than
# Phase8 at C/N 5-12 dB (about 1.5-2 dB threshold), beats Golden throughout.
# Two-bundle steady-state Phase5 WBFM core.
# Full Q4/I4 (8-bit Cartesian) input at 40 MS/s.
# 20 MS/s unique 6-bit CVBS output, duplicated as [D,D] at 40 MHz DAC clock.
#
# Two instructions total; the first two output pairs establish the pipeline
# state after prefetch. Their DAC values are startup-only and untrusted.
#   address_delta  - steady-state bundle 1
#   emit           - steady-state bundle 2 (loops back to address_delta)
#
# LUT layout (dual-purpose 16-bit words):
#   LUT[packed_q4i4].bits[12:8]          = 5-bit Phase5 state (uniform polar bins)
#   LUT[(prev_phase5<<5)|curr_phase5]    = 6-bit DAC code (centroid delta, P20/G2)
#
# O26..O30 holds the previous Phase5 state across ALL ring/DMA boundaries.
# cfg eof_on downstream + cfg trailing_bytes 0 ensures PARLIO TX loop_transmission
# never generates a downstream EOF, so the BitScrambler runs uninterrupted forever.
#
# Reference: Seamless Golden 16K (build-golden-notel) -- proven best live build.
# P20 pedestal, G2 gain, current-minus-previous polarity.

cfg prefetch true
cfg eof_on downstream
cfg trailing_bytes 0
cfg lut_width_bits 16

# Embedded 1044-entry LUT. Hardware oracle v9 proved embedded LUT data is
# byte-exact at 20 MS/s; a separately preloaded LUT is NOT retained by the
# active PARLIO TX run on ESP32-C5 / IDF 6.0.x.
lut 1044 1562 1824 1830 1836 1842 2104 2110 6207 6207 6207 6463 6463 6463 7743 319 512 1024 1280 1536 1536 1792 1792 1792 6400 6400 6400 6656 6656 7682 7688 270 526 788 1050 1312 1318 1580 1586 1592 6718 6719 6719 6975 6975 7487 7743 63 319 512 768 1024 1280 1280 1536 1536 6656 6912 6912 6912 7424 7680 7682 8 264 526 788 794 1056 1318 1324 1330 6968 6974 6975 7231 7487 7743 7999 63 319 319 512 768 1024 1024 1024 1280 6912 7168 7168 7168 7424 7680 7936 2 2 264 526 788 794 1056 1062 1068 7218 7224 7230 7487 7487 7743 7999 63 63 319 575 512 768 768 1024 1024 7168 7168 7424 7424 7680 7680 7936 0 4096 3842 3592 3598 3348 3354 3104 3110 5164 5170 4920 4926 4671 4671 4415 4159 4159 3903 3647 3391 3328 3072 3072 3072 5120 5120 5120 4864 4864 4608 4352 4096 4096 3584 3330 3336 3086 3092 3098 2848 5414 5164 5170 4920 4926 4671 4415 4159 3647 3647 3391 3135 3135 2816 2816 2816 5376 5376 5376 5120 4864 4864 4608 4352 3584 3328 3072 3074 2824 2830 2836 2586 5664 5414 5420 5426 5176 4926 4671 4415 3391 3135 3135 2879 2623 2623 2560 2560 5632 5632 5632 5376 5376 5120 4864 3328 3072 2816 2560 2560 2562 2312 2318 2324 5914 5920 5926 5676 5682 5432 5182 3391 2623 2367 2367 2367 2111 2111 2111 2048 6144 6144 6144 5888 5888 5888 5632 2816 2304 2048 2048 2048 2048 2050 2056 2062 6164 6170 6176 6438 6444 5682 5432 5182 1599 1599 1599 1599 1855 1855 1855 1855 6400 6400 6400 6656 6656 6912 7168 7680 256 1536 1536 1536 1536 1536 1538 1544 6670 6676 6682 6944 6950 7212 7474 7992 318 575 831 1599 1343 1599 1343 1599 6719 6912 6912 6912 7168 7424 7680 7936 256 512 768 768 1024 1280 1280 1282 6920 6926 6932 7194 7456 7462 7724 7986 56 318 575 831 831 1087 1087 1343 6975 7231 7168 7168 7424 7680 7936 0 0 256 512 768 768 1024 1024 1024 7170 7176 7182 7444 7450 7712 7974 44 50 312 574 575 831 831 1087 1087 7231 7231 7487 7424 7680 7680 7936 0 3840 3840 3584 3584 3328 3328 3072 3072 5120 5122 4872 4878 4628 4634 4384 4134 4140 3890 3640 3646 3391 3135 3135 3135 5183 5183 5183 4927 4608 4608 4352 4096 3840 3840 3584 3328 3072 3072 3072 2816 5376 5120 5122 4872 4878 4628 4378 4128 3878 3628 3378 3384 3134 3135 2879 2879 5439 5439 5183 5183 4927 4608 4608 4096 3840 3584 3328 3072 2816 2816 2816 2560 5632 5376 5376 5122 5128 4878 4628 4122 3872 3366 3116 2866 2872 2622 2623 2623 5695 5439 5439 5439 5183 5183 4608 4352 3584 3072 2816 2560 2560 2304 2304 2304 5888 5888 5632 5632 5378 5128 4878 4372 3098 2592 2598 2348 2354 2360 2366 2111 6207 6207 6207 5695 5695 5439 5183 4608 7168 1536 1792 1792 1792 2048 2048 2048 6144 6144 6144 6144 6400 6402 6408 6670 7444 1050 1312 1574 1580 1842 1848 1854 6463 6463 6463 6719 6719 6719 6975 7231 7487 768 1024 1280 1280 1536 1536 1536 6656 6656 6656 6656 6912 7168 7170 7432 270 532 794 1056 1318 1324 1330 1592 6718 6719 6975 6975 7231 7231 7487 7743 319 575 768 768 1024 1280 1280 1280 6912 6912 6912 7168 7168 7424 7424 7682 8 270 532 794 800 1062 1068 1330 6968 7230 7231 7231 7487 7487 7743 63 63 319 575 768 768 1024 1024 1024 7168 7168 7168 7424 7424 7680 7936 0 2 264 526 532 794 800 1062 1068 7218 7224 7486 7487 7743 7743 7999 63 4159 3903 3647 3647 3328 3328 3072 3072 5120 5120 4864 4864 4608 4608 4352 4096 4096 3842 3592 3342 3348 3098 3104 3110 5164 5170 5176 4926 4927 4671 4415 4159 4159 3903 3647 3647 3391 3072 3072 2816 5376 5120 5120 4864 4864 4608 4608 4352 4096 3840 3586 3592 3086 3092 2842 2848 5414 5420 5170 5176 4926 4927 4671 4415 4159 3647 3647 3391 2879 2879 2816 2560 5632 5632 5376 5376 5120 4864 4608 4352 4096 3584 3584 2818 2824 2574 2580 2586 5664 5670 5676 5426 5432 5182 4927 4671 4159 3647 3647 2623 2623 2367 2367 2304 5888 5888 5888 5632 5632 5376 5120 4608 4096 3584 2304 2304 2306 2056 2062 2068 6170 6176 5926 5932 5938 5944 5694 5439 575 1087 1343 1599 1599 2111 2111 2111 6144 6144 6400 6400 6400 6400 6912 7424 256 768 1024 1280 1536 1538 1800 1806 6420 6426 6432 6694 6700 6962 7224 7742 318 575 1087 1087 1343 1343 1343 1599 6719 6656 6656 6912 6912 7168 7424 7936 256 512 768 1024 1024 1280 1282 1544 6670 6676 6938 6944 7206 7468 7730 7992 56 574 575 831 1087 1087 1343 1343 6975 6975 6912 7168 7424 7424 7680 7936 0 256 512 768 768 1024 1024 1282 6920 7182 7188 7450 7456 7718 7980 7986 50 312 574 575 831 1087 1087 1087 7231 7231 7231 7424 7680 7680 7936 0 0 256 512 512 768 768 1024 1024 7170 7176 7438 7444 7706 7712 7974 44 4140 3890 3640 3646 3391 3391 3135 3135 5183 5183 4927 4927 4608 4608 4352 4096 4096 3840 3584 3328 3328 3072 3072 3072 5120 5122 5128 4878 4884 4634 4384 4134 4134 3884 3634 3384 3390 3135 3135 2879 5439 5183 5183 4927 4927 4608 4352 4096 3840 3584 3328 3328 3072 3072 2816 2816 5376 5376 5378 5128 4878 4884 4634 4384 3872 3622 3372 3122 2872 2878 2879 2623 5695 5439 5695 5439 5183 4927 4608 4352 3840 3328 3072 2816 2816 2560 2560 2560 5632 5632 5632 5634 5640 5646 5396 4378 3610 3104 2854 2604 2610 2360 2366 2367 5951 5951 5951 5951 5695 5695 5695 5632 1024 1280 1536 2304 2304 2048 2048 2048 6144 6144 6144 6144 6146 6152 6158 6164

address_delta:
    # At startup L has no valid phase; emit primes the first real raw address.
    # Thereafter L8..L12 is current Phase5. Preserve it in O26..O30 and
    # address LUT[(previous << 5) | current].
    set 26..30 L8..L12,
    set 16 L8,
    set 17 L9,
    set 18 L10,
    set 19 L11,
    set 20 L12,
    set 21 O26,
    set 22 O27,
    set 23 O28,
    set 24 O29,
    set 25 O30,
    set 31 L

emit:
    # Second lookup's low six bits are the complete calibrated DAC code (L0..L5).
    # Emit two 8-bit DAC samples at 40 MS/s: Byte 0 (bits 0..5) and
    # Byte 1 (bits 8..13). Identical bytes retain a 50 ns analog hold [D,D].
    set 0..5 L0..L5,
    set 6..7 L,
    set 8..13 L0..L5,
    set 14..15 L,
    set 26..30 O26..O30,
    set 16 8,
    set 17 9,
    set 18 10,
    set 19 11,
    set 20 12,
    set 21 13,
    set 22 14,
    set 23 15,
    # History: decoder bank = retained state's quadrant.
    set 24 O29,
    set 25 O30,
    set 31 L,
    read 16,
    write 16,
    jmp address_delta
